# Unreal build output
**/Binaries/
**/Intermediate/
**/Saved/
**/DerivedDataCache/
**/.vscode/
*.code-workspace
compile_commands.json
out/

# Model artifacts: never in git, filled by external scripts
*.onnx
*.plan
*.engine
*.trt
*.pt
*.pth
*.safetensors
*.gguf
*.npz
triton/model_repository/*/[0-9]*/*
!triton/model_repository/*/[0-9]*/model.py

# misc
.DS_Store

# third-party build output (produced by scripts/build_grpc_*.sh)
third_party/_build/
ue/Plugins/ManipleInference/Source/ThirdParty/ManipleGrpc/lib/
ue/Plugins/ManipleInference/Source/ThirdParty/ManipleGrpc/include/
ue/Plugins/ManipleInference/Source/ThirdParty/ManipleGrpc/tools/
triton/checkpoints/*
!triton/checkpoints/.gitkeep

# python
__pycache__/
*.pyc

# policies exported by the trainer (config + versions are generated)
triton/model_repository/*_policy/

# python sandboxes
.venv/
