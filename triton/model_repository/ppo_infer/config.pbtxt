# ppo_infer: inference entry point. channel=latest is answered by ppo_train from its current weights;
# best / stable / <version> are exported static models, loaded on first use and unloaded when idle.
name: "ppo_infer"
backend: "python"
max_batch_size: 0
input [
  { name: "name",    data_type: TYPE_STRING, dims: [ 1 ] },
  { name: "obs",     data_type: TYPE_FP32,   dims: [ -1, -1 ] },
  { name: "explore", data_type: TYPE_BOOL,   dims: [ 1 ], optional: true },
  { name: "channel", data_type: TYPE_STRING, dims: [ 1 ], optional: true }   # stable (default) | best | latest | <version>
]
output [
  { name: "action",         data_type: TYPE_FP32,   dims: [ -1, -1 ] },
  { name: "action_index",   data_type: TYPE_INT64,  dims: [ -1 ] },
  { name: "logp",           data_type: TYPE_FP32,   dims: [ -1 ] },
  { name: "policy_version", data_type: TYPE_INT64,  dims: [ 1 ] },
  { name: "status",         data_type: TYPE_STRING, dims: [ 1 ] }
]
instance_group [ { count: 1, kind: KIND_CPU } ]

parameters { key: "model_repository" value: { string_value: "/models" } }
parameters { key: "train_model"      value: { string_value: "ppo_train" } }
parameters { key: "idle_unload_sec"  value: { string_value: "600" } }
